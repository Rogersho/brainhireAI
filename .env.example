# Backend Express API URL (used by Next.js rewrites and/or direct client calls)
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Must match JWT_SECRET in backend/.env so Next.js proxy.ts can verify auth cookies
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
