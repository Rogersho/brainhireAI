PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brainhire_db

# Strong random secret (min 32 chars) — must match JWT_SECRET in root .env.local
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Google Gemini AI (comma-separated keys supported for fallback)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
