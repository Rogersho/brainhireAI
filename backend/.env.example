PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string (Neon or local PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Strong random secret (64-128 chars) — must match JWT_SECRET in root .env.local
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN=7d

# NVIDIA NIM AI (comma-separated keys supported for fallback)
NVIDIA_API_KEYS=nvapi-your-nvidia-api-key
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# S3-compatible Object Storage (e.g., Neon Storage / AWS S3 / R2)
AWS_ENDPOINT_URL_S3=https://your-storage-endpoint.aws.neon.tech
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-2
S3_BUCKET=assets
